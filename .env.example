# BusinessIntelligence.ai — Environment Variables
# Copy this file to .env and fill in the values for your environment.
# Never commit .env to version control.

# ---------------------------------------------------------------------------
# PostgreSQL
# ---------------------------------------------------------------------------
# Connection string for the structured KPI / event store.
# Format: postgresql://<user>:<password>@<host>:<port>/<database>
DATABASE_URL=postgresql://biai:biai@localhost:5432/biai

# ---------------------------------------------------------------------------
# ChromaDB
# ---------------------------------------------------------------------------
# Hostname of the ChromaDB instance (unstructured evidence + precedent store).
CHROMA_HOST=localhost
CHROMA_PORT=8000

# ---------------------------------------------------------------------------
# LLM Provider Selection
# ---------------------------------------------------------------------------
# Select active LLM provider: "ollama" (default local) or "groq" (cloud)
LLM_PROVIDER=ollama

# ---------------------------------------------------------------------------
# Ollama LLM (Local Provider)
# ---------------------------------------------------------------------------
# Base URL for the local Ollama inference server.
# Default model: qwen3:8b  |  Fallback: gemma3:12b
# Embeddings: bge-m3 (also used when GroqProvider is selected)
OLLAMA_HOST=http://localhost:11434

# ---------------------------------------------------------------------------
# Groq LLM (Cloud Provider)
# ---------------------------------------------------------------------------
# Required when LLM_PROVIDER=groq
GROQ_API_KEY=
GROQ_MODEL=llama-3.3-70b-versatile
GROQ_BASE_URL=https://api.groq.com/openai/v1
GROQ_TIMEOUT=30.0
GROQ_MAX_RETRIES=3

# ---------------------------------------------------------------------------
# Application
# ---------------------------------------------------------------------------
# Set to "development" or "production"
APP_ENV=development

# Optional: override models
# LLM_MODEL=qwen3:8b
# LLM_FALLBACK_MODEL=gemma3:12b
# EMBED_MODEL=bge-m3
