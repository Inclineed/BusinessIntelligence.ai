# BusinessIntelligence.ai — Environment Variables
# Copy this file to .env and fill in the values for your environment.
# Never commit .env to version control.

# ---------------------------------------------------------------------------
# PostgreSQL
# ---------------------------------------------------------------------------
# Connection string for the structured KPI / event store.
# Format: postgresql://<user>:<password>@<host>:<port>/<database>
DATABASE_URL=postgresql://biai:biai@localhost:5432/biai

# ---------------------------------------------------------------------------
# ChromaDB
# ---------------------------------------------------------------------------
# Hostname of the ChromaDB instance (unstructured evidence + precedent store).
CHROMA_HOST=localhost
CHROMA_PORT=8000

# ---------------------------------------------------------------------------
# LLM Provider Selection
# ---------------------------------------------------------------------------
# Select active LLM provider: "ollama" (local), "groq", "openai", or "anthropic" (cloud)
LLM_PROVIDER=ollama

# ---------------------------------------------------------------------------
# Ollama LLM (Local Provider)
# ---------------------------------------------------------------------------
# Base URL for the local Ollama inference server.
# Default model: qwen3:8b  |  Fallback: gemma3:12b
# Embeddings: bge-m3 (also used as standard local embedding engine)
OLLAMA_HOST=http://localhost:11434

# ---------------------------------------------------------------------------
# Groq LLM (Cloud Provider)
# ---------------------------------------------------------------------------
# Required when LLM_PROVIDER=groq
GROQ_API_KEY=
GROQ_MODEL=llama-3.3-70b-versatile
GROQ_BASE_URL=https://api.groq.com/openai/v1
GROQ_TIMEOUT=45.0
GROQ_MAX_RETRIES=5

# Credential mode: "single" (default / production) or "local_pool" (local testing)
GROQ_CREDENTIAL_MODE=single
# GROQ_API_KEYS=key1,key2,key3

# ---------------------------------------------------------------------------
# OpenAI LLM (Cloud Provider)
# ---------------------------------------------------------------------------
# Required when LLM_PROVIDER=openai
OPENAI_API_KEY=
OPENAI_MODEL=gpt-4o-mini
OPENAI_EMBED_MODEL=text-embedding-3-small
OPENAI_BASE_URL=https://api.openai.com/v1
OPENAI_TIMEOUT=60.0
OPENAI_MAX_RETRIES=4
# OPENAI_API_KEYS=key1,key2,key3

# ---------------------------------------------------------------------------
# Anthropic LLM (Cloud Provider)
# ---------------------------------------------------------------------------
# Required when LLM_PROVIDER=anthropic
ANTHROPIC_API_KEY=
ANTHROPIC_MODEL=claude-3-5-haiku-20241022
ANTHROPIC_BASE_URL=https://api.anthropic.com/v1
ANTHROPIC_TIMEOUT=60.0
ANTHROPIC_MAX_RETRIES=4
# ANTHROPIC_API_KEYS=key1,key2,key3

# ---------------------------------------------------------------------------
# Application
# ---------------------------------------------------------------------------
# Set to "development" or "production"
APP_ENV=development

# Optional: override models
# LLM_MODEL=qwen3:8b
# LLM_FALLBACK_MODEL=gemma3:12b
# EMBED_MODEL=bge-m3
